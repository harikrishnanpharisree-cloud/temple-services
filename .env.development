# Loaded automatically by `npm run dev` (Vite mode = development).
# Safe to commit — these point at your own local Supabase stack, not a
# real project, so there's nothing secret here.
#
# Fill in the two values below after running `npx supabase start` —
# it prints them as "API URL" and "anon key" in its output.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY_FROM_SUPABASE_START
